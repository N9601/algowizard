# Copy this file to .env.local and fill in the values you need.
# Every variable is optional: the visualizers work without any of them.

# Gemini powers the AlgoBot chatbot. Without a key the chat UI still loads,
# but replies fail.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase powers accounts, saved visualizer states, learning progress, and
# chat history. Leave these empty to run the app in guest mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, used only when the publishable key above is empty:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only read by src/lib/supabase/admin.ts, which no route uses yet.
# Never expose this key to client code.
SUPABASE_SERVICE_ROLE_KEY=
